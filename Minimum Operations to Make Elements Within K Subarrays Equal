//Pattern:
- Sliding Window
- Two Multisets (Median Maintenance)
- Dynamic Programming (DP)

//Complexity:
- Time: (O(nlog x + nk)
- Space: (O(nk+x)


class Solution {
public:
    multiset<int> low, high;
    long long lowSum = 0, highSum = 0;

    void balance() {
        int target = (low.size() + high.size() + 1) / 2;

        while (low.size() > target) {
            int v = *low.rbegin();
            low.erase(prev(low.end()));
            lowSum -= v;
            high.insert(v);
            highSum += v;
        }

        while (low.size() < target) {
            int v = *high.begin();
            high.erase(high.begin());
            highSum -= v;
            low.insert(v);
            lowSum += v;
        }
    }

    void add(int v) {
        if (low.empty() || v <= *low.rbegin()) {
            low.insert(v);
            lowSum += v;
        } else {
            high.insert(v);
            highSum += v;
        }
        balance();
    }

    void remove(int v) {
        auto it = low.find(v);

        if (it != low.end()) {
            low.erase(it);
            lowSum -= v;
        } else {
            it = high.find(v);
            high.erase(it);
            highSum -= v;
        }
        balance();
    }

    long long getCost() {
        long long median = *low.rbegin();

        return median * low.size() - lowSum
             + highSum - median * high.size();
    }

    long long minOperations(vector<int>& nums, int x, int k) {
        int n = nums.size();

        vector<long long> cost(n - x + 1);

        for (int i = 0; i < x; i++)
            add(nums[i]);

        cost[0] = getCost();

        for (int i = x; i < n; i++) {
            remove(nums[i - x]);
            add(nums[i]);
            cost[i - x + 1] = getCost();
        }

        const long long INF = LLONG_MAX / 4;

        vector<vector<long long>> dp(
            n + 1, vector<long long>(k + 1, INF)
        );

        for (int i = 0; i <= n; i++)
            dp[i][0] = 0;

        for (int i = n - 1; i >= 0; i--) {
            for (int j = 1; j <= k; j++) {
                dp[i][j] = dp[i + 1][j];

                if (i + x <= n && dp[i + x][j - 1] != INF) {
                    dp[i][j] = min(
                        dp[i][j],
                        cost[i] + dp[i + x][j - 1]
                    );
                }
            }
        }

        return dp[0][k];
    }
};
