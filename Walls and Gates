//Pattern: Multi-Source BFS

// Time: O(m × n) · Space: O(m × n)

class Solution {
public:
    void wallsAndGates(vector<vector<int>>& rooms) {
        int m = rooms.size();
        if (m == 0) return;

        int n = rooms[0].size();

        queue<pair<int, int>> q;

        int dr[] = {-1, 1, 0, 0};
        int dc[] = {0, 0, -1, 1};

        // Add all gates to the queue
        for (int r = 0; r < m; r++) {
            for (int c = 0; c < n; c++) {
                if (rooms[r][c] == 0) {
                    q.push({r, c});
                }
            }
        }

        while (!q.empty()) {
            auto [r, c] = q.front();
            q.pop();

            for (int d = 0; d < 4; d++) {
                int nr = r + dr[d];
                int nc = c + dc[d];

                if (nr >= 0 && nc >= 0 &&
                    nr < m && nc < n &&
                    rooms[nr][nc] == INT_MAX) {

                    rooms[nr][nc] = rooms[r][c] + 1;

                    q.push({nr, nc});
                }
            }
        }
    }
};
